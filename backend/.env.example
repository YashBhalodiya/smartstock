# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Use 'localhost' when running Node locally on host machine:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartstock_db?schema=public
# Use container service name 'postgres' when running inside Docker container:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/smartstock_db?schema=public

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Redis / BullMQ Background Jobs
# Use 'localhost' when running Node locally on host machine:
REDIS_URL=redis://localhost:6379
# Use container service name 'redis' when running inside Docker container:
# REDIS_URL=redis://redis:6379

# SMTP Email Worker Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@smartstock.com
